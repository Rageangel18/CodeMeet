@page "/"
@namespace CodeMeet.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CodeMeet</title>
    <base href="~/" />

    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="css/open-iconic/font/css/open-iconic-bootstrap.min.css" />
    <link rel="stylesheet" href="css/codemeet.css" />
</head>
<body class="cm-theme cm-theme-dark">
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <!-- SignalR client (только один источник) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <!-- Ваши скрипты -->
    <script src="~/js/sessionVideoHub.js" asp-append-version="true"></script>
    <script src="~/js/videoTest.js" asp-append-version="true"></script>
    <script src="~/js/prejoinVideo.js" asp-append-version="true"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>

    <!-- Monaco (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs/loader.js"></script>
    <script>
        (function () {
            var base = 'https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs';

            require.config({ paths: { vs: base } });

            window.monacoLoaded = new Promise(function (resolve, reject) {
                try {
                    require(['vs/editor/editor.main'], function () { resolve(); }, function (err) { reject(err); });
                } catch (e) {
                    reject(e);
                }
            });
        })();
    </script>

    <!-- ВАЖНО: blazor.server.js последним -->
    <script src="_framework/blazor.server.js"></script>
</body>
</html>

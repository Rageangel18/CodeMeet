@page "/sessions/admin"
@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using CodeMeet.BLL.DTOs.Sessions
@using CodeMeet.DAL.Enums
@using CodeMeet.BLL.Services.Interfaces

@inject ISessionService SessionService
@inject NavigationManager Nav

<div class="cm-page">
    <div class="cm-page-header">
        <div>
            <h1 class="cm-page-title">All sessions</h1>
            <p class="cm-page-subtitle">
                Admin / HR / Recruiter view. You see all sessions in your organization.
            </p>
        </div>

        <div>
            <button class="cm-btn-primary cm-btn-small"
                    @onclick="@(() => Nav.NavigateTo("/sessions/create"))">
                + Schedule session
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_roleInfo))
    {
        <p class="cm-field-hint">
            Role: @_roleInfo
        </p>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="cm-alert cm-alert-error">@_error</div>
    }
    else if (_loading)
    {
        <p>Loading sessions…</p>
    }
    else if (_sessions is null || _sessions.Count == 0)
    {
        <div class="cm-alert">
            No sessions found for this organization yet.
        </div>
    }
    else
    {
        <div class="cm-filter-bar">
            <span class="cm-filter-label">Status</span>

            <button class="@GetFilterClass(null)"
                    @onclick="() => SetFilterAsync(null)">
                All
            </button>

            <button class="@GetFilterClass(SessionStatus.Draft)"
                    @onclick="() => SetFilterAsync(SessionStatus.Draft)">
                Draft
            </button>

            <button class="@GetFilterClass(SessionStatus.Scheduled)"
                    @onclick="() => SetFilterAsync(SessionStatus.Scheduled)">
                Scheduled
            </button>

            <button class="@GetFilterClass(SessionStatus.Live)"
                    @onclick="() => SetFilterAsync(SessionStatus.Live)">
                Live
            </button>

            <button class="@GetFilterClass(SessionStatus.Completed)"
                    @onclick="() => SetFilterAsync(SessionStatus.Completed)">
                Completed
            </button>
        </div>

        <table class="cm-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Start (UTC)</th>
                    <th>End (UTC)</th>
                    <th style="width: 320px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _sessions)
                {
                    <tr>
                        <td @onclick="@(() => OpenSession(s.SessionId))" style="cursor:pointer;">
                            @s.Title
                        </td>
                        <td>
                            <span class="cm-tag">@s.Status</span>
                        </td>
                        <td>@(s.ScheduledStartUtc?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                        <td>@(s.ScheduledEndUtc?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                        <td>
                            <button class="cm-btn-ghost cm-btn-xxs"
                                    @onclick="@(() => OpenSession(s.SessionId))">
                                Details
                            </button>

                            @if (_canConfirmDraft && s.Status == SessionStatus.Draft)
                            {
                                <button class="cm-btn-primary cm-btn-xxs"
                                        style="margin-left:4px;"
                                        disabled="@_busyConfirming"
                                        @onclick="@(() => ConfirmDraftAsync(s.SessionId))">
                                    Confirm
                                </button>
                            }

                            @if (CanJoin(s))
                            {
                                <button class="cm-btn-primary cm-btn-xxs"
                                        style="margin-left:4px;"
                                        @onclick="@(() => JoinSession(s.SessionId))">
                                    Join
                                </button>
                            }

                            @if (s.Status == SessionStatus.Completed)
                            {
                                <button class="cm-btn-ghost cm-btn-xxs"
                                        style="margin-left:4px;"
                                        @onclick="@(() => OpenSummary(s.SessionId))">
                                    Summary
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private Guid? _orgId;
    private HashSet<string> _roles = new(StringComparer.OrdinalIgnoreCase);
    private string? _roleInfo;

    private List<SessionSummaryDto>? _sessions;
    private bool _loading;
    private string? _error;
    private SessionStatus? _statusFilter;

    private bool _canConfirmDraft;
    private bool _busyConfirming;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        var user = authState.User;

        if (user.Identity is null || !user.Identity.IsAuthenticated)
        {
            _error = "You must be signed in.";
            return;
        }

        foreach (var c in user.Claims.Where(c =>
                     c.Type == ClaimTypes.Role || c.Type == "role"))
        {
            _roles.Add(c.Value);
        }

        _roleInfo = string.Join(", ", _roles);

        var isAdminLike =
            _roles.Contains("OrgAdmin") ||
            _roles.Contains("Recruiter") ||
            _roles.Contains("HiringManager");

        if (!isAdminLike)
        {
            _error = "This view is only for OrgAdmin / Recruiter / HiringManager.";
            return;
        }

        _canConfirmDraft = isAdminLike;

        var orgClaim = user.FindFirst("org_id");
        if (orgClaim is null || !Guid.TryParse(orgClaim.Value, out var orgId))
        {
            _error = "Your organization is not set in auth claims.";
            return;
        }

        _orgId = orgId;

        await LoadSessionsAsync();
    }

    private async Task LoadSessionsAsync()
    {
        if (_orgId is null)
            return;

        _loading = true;
        _error = null;

        try
        {
            var sessions = await SessionService.GetByOrgAsync(_orgId.Value, _statusFilter);
            _sessions = sessions.ToList();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load sessions: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SetFilterAsync(SessionStatus? status)
    {
        if (_statusFilter == status)
            return;

        _statusFilter = status;
        await LoadSessionsAsync();
    }

    private string GetFilterClass(SessionStatus? status)
    {
        var isActive = _statusFilter == status
                       || (_statusFilter is null && status is null);

        return isActive ? "cm-header-btn cm-header-btn-primary"
                        : "cm-header-btn";
    }

    private void OpenSession(Guid id)
    {
        Nav.NavigateTo($"/sessions/{id}");
    }

    private async Task ConfirmDraftAsync(Guid sessionId)
    {
        if (!_canConfirmDraft)
            return;

        _busyConfirming = true;

        try
        {
            await SessionService.ChangeStatusAsync(sessionId, SessionStatus.Scheduled);
            await LoadSessionsAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to confirm session: {ex.Message}";
        }
        finally
        {
            _busyConfirming = false;
        }
    }

    private static bool CanJoin(SessionSummaryDto s)
        => s.Status == SessionStatus.Live;

    private void JoinSession(Guid sessionId)
    {
        Nav.NavigateTo($"/sessions/{sessionId}/prejoin");
    }

    private void OpenSummary(Guid sessionId)
    {
        Nav.NavigateTo($"/sessions/{sessionId}/summary");
    }
}
